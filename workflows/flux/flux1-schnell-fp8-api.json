{
  "1": {
    "inputs": {
      "unet_name": "flux1-schnell-fp8.safetensors",
      "weight_dtype": "fp8_e4m3fn"
    },
    "class_type": "UNETLoader",
    "_meta": { "title": "FLUX.1 Schnell (FP8 base)" }
  },
  "2": {
    "inputs": {
      "clip_name1": "t5xxl_fp8_e4m3fn.safetensors",
      "clip_name2": "clip_l.safetensors",
      "type": "flux"
    },
    "class_type": "DualCLIPLoader",
    "_meta": { "title": "T5-XXL FP8 + CLIP-L" }
  },
  "3": {
    "inputs": { "vae_name": "ae.safetensors" },
    "class_type": "VAELoader",
    "_meta": { "title": "FLUX VAE (ae)" }
  },
  "4": {
    "inputs": {
      "text": "a photograph of a red fox in tall grass at golden hour, shallow depth of field",
      "clip": ["2", 0]
    },
    "class_type": "CLIPTextEncode",
    "_meta": { "title": "Prompt" }
  },
  "5": {
    "inputs": { "conditioning": ["4", 0] },
    "class_type": "ConditioningZeroOut",
    "_meta": { "title": "Negative (zeroed - Schnell is CFG 1.0)" }
  },
  "6": {
    "inputs": { "width": 1024, "height": 1024, "batch_size": 1 },
    "class_type": "EmptySD3LatentImage",
    "_meta": { "title": "Latent" }
  },
  "7": {
    "inputs": {
      "seed": 0,
      "steps": 4,
      "cfg": 1.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0,
      "model": ["1", 0],
      "positive": ["4", 0],
      "negative": ["5", 0],
      "latent_image": ["6", 0]
    },
    "class_type": "KSampler",
    "_meta": { "title": "KSampler (4-step Schnell)" }
  },
  "8": {
    "inputs": { "samples": ["7", 0], "vae": ["3", 0] },
    "class_type": "VAEDecode",
    "_meta": { "title": "Decode" }
  },
  "9": {
    "inputs": { "filename_prefix": "flux-schnell/LU", "images": ["8", 0] },
    "class_type": "SaveImage",
    "_meta": { "title": "Save" }
  }
}
