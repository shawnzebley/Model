# Copy to .env and fill in what you have. Every key is optional — the tools
# that need one say so when it is missing, and the rest keep working.
# .env is gitignored; never commit real keys.

# Breach lookups (search_breach)
HIBP_API_KEY=

# IP intelligence (search_ip)
IPINFO_TOKEN=
IP2LOCATION_API_KEY=
ABUSEIPDB_API_KEY=

# Infrastructure and reputation
SHODAN_API_KEY=
VIRUSTOTAL_API_KEY=
CENSYS_API_ID=
CENSYS_SECRET=

# GitHub profile/repo/email discovery — raises the rate limit 60 -> 5000 req/h
GITHUB_TOKEN=

# Live dorking and page scraping (search_dorks_live, scrape_url)
BRIGHTDATA_API_KEY=
BRIGHTDATA_SERP_ZONE=serp_api1
BRIGHTDATA_UNLOCKER_ZONE=web_unlocker1
